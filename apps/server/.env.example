# Server port (assigned automatically by Render in production)
PORT=3001

# Network host to bind (0.0.0.0 required for containers and cloud hosting)
HOST=0.0.0.0

# Environment mode: development, production, test
NODE_ENV=development

# Allowed WebSocket origins (comma-separated URLs without trailing slashes)
# In production on Render: set to your frontend domain (e.g. https://games.anilsuva.com)
WEB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Pino logging level: trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=info
