{
  "name": "omniplay",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:server": "npm run dev -w server",
    "dev:all": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "build:web": "npm run build -w web",
    "build:server": "npm run build -w server",
    "build": "npm run build --workspaces --if-present",
    "lint:web": "npm run lint -w web",
    "lint": "npm run lint -w web",
    "test:web": "npm run test -w web",
    "test:server": "npm run test -w server",
    "test": "npm test --workspaces --if-present",
    "typecheck:web": "npm run typecheck -w web",
    "typecheck:server": "npm run typecheck -w server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
